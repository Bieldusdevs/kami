// Schema do banco de dados da Kamikaze
// Funciona com qualquer Postgres (Vercel Postgres, Neon, Supabase, Railway...)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  usernameLower String   @unique
  email        String    @unique
  passwordHash String
  role         String    @default("Membro")
  createdAt    DateTime  @default(now())

  messages Message[]
  orders   Order[]

  @@index([usernameLower])
}

// Comandos do FiveM (cadastrados pelo admin, visíveis na página /comandos)
model Command {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("geral")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, position])
}

// Arquivos para download dos membros (citizen, mod som e outros)
model DownloadFile {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("citizen") // citizen | modsom | outros
  url         String
  description String?
  version     String?
  size        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, createdAt])
}

// Configurações do site que o admin pode alterar pelo painel
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Order {
  id        String   @id @default(cuid())
  game      String
  item      String
  qty       String
  notes     String?
  status    String   @default("pendente") // pendente | andamento | concluido
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
}
