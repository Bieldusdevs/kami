# ---------------------------------------------------------------------------
# KAMIKAZE 神風 — exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Banco PostgreSQL. Vale Vercel Postgres, Neon, Supabase, Railway...
# Neon/Supabase/Vercel exigem SSL: mantenha ?sslmode=require no final.
DATABASE_URL="postgresql://usuario:senha@host:5432/kamikaze?sslmode=require"

# Segredo usado para assinar o cookie de sessão (JWT).
# Gere um valor forte com:  openssl rand -base64 48
JWT_SECRET="cole-aqui-um-valor-aleatorio-longo"

# --- opcionais -------------------------------------------------------------

# Nome do cookie de sessão (padrão: kamikaze_session)
# SESSION_COOKIE_NAME="kamikaze_session"

# Força o cookie de sessão como seguro/não seguro.
# Use "0" se o site roda em HTTP (sem HTTPS) e o login não "gruda".
# KAMI_COOKIE_SECURE="0"

# Token para proteger o endpoint de diagnóstico /api/health
# HEALTH_TOKEN="um-token-qualquer"

# Usuário que será promovido a Dono automaticamente ao entrar (bootstrap).
# Coloque aqui o SEU usuário para liberar o painel admin na primeira vez.
# OWNER_USERNAME="novak"

# Habilita o upload de arquivos ( precisa do Vercel Blob ativado no projeto,
# que cria a BLOB_READ_WRITE_TOKEN sozinho ). Sem isso, o painel usa só links.
# BLOB_READ_WRITE_TOKEN=""

# Webhook do Discord: a equipe recebe um aviso no canal quando chega uma
# solicitação de entrada e quando ela é aprovada/recusada. Crie em:
#   Discord → canal → Editar canal → Integrações → Webhooks → Novo webhook.
# Sem essa variável o site funciona igual, só não envia os avisos.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# URL pública do site (usada nas meta tags de compartilhamento/OG image).
# Na Vercel normalmente não precisa: a VERCEL_URL é usada automaticamente.
# NEXT_PUBLIC_SITE_URL="https://kami.vercel.app"
