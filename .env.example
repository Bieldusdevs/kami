# ---------------------------------------------------------------------------
# KAMIKAZE 神風 — exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Banco PostgreSQL. Vale Vercel Postgres, Neon, Supabase, Railway...
# Neon/Supabase/Vercel exigem SSL: mantenha ?sslmode=require no final.
DATABASE_URL="postgresql://usuario:senha@host:5432/kamikaze?sslmode=require"

# Segredo usado para assinar o cookie de sessão (JWT).
# Gere um valor forte com:  openssl rand -base64 48
JWT_SECRET="cole-aqui-um-valor-aleatorio-longo"

# --- opcionais -------------------------------------------------------------

# Nome do cookie de sessão (padrão: kamikaze_session)
# SESSION_COOKIE_NAME="kamikaze_session"

# Força o cookie de sessão como seguro/não seguro.
# Use "0" se o site roda em HTTP (sem HTTPS) e o login não "gruda".
# KAMI_COOKIE_SECURE="0"

# Token para proteger o endpoint de diagnóstico /api/health
# HEALTH_TOKEN="um-token-qualquer"
